# Force LF line endings for shell scripts and configs (needed for Linux/HF deployment)
*.sh       text eol=lf
*.sql      text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.ts       text eol=lf
*.java     text eol=lf
*.properties text eol=lf

# Binary files - no line ending conversion
*.jar      binary
*.png      binary
*.jpg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
